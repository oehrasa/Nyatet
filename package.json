{
  "name": "nyatet",
  "version": "1.0.0",
  "description": "Nyatet - catatan keuangan pribadi (offline, local)",
  "main": "script.js",
  "scripts": {
    "build:web": "rm -rf www && mkdir -p www && cp index.html script.js style.css favicon.png manifest.json sw.js www/ && cp -r icons www/",
    "sync": "npm run build:web && cap sync",
    "build:apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-printer": "^7.0.14"
  }
}
